# ── Agent runtime ──────────────────────────────────────────────────────────
# Default runtime for new hires: foundry | chat | ollama | mock. Unset = the
# first one configured (foundry, chat, ollama), else mock. Each agent keeps its own.
# AGENT_RUNTIME_DEFAULT=mock

# ── Azure AI Foundry Agent Service (runtime "foundry") ─────────────────────
# Project endpoint from the Foundry portal (Overview → Endpoint), e.g.
#   https://<resource>.services.ai.azure.com/api/projects/<project>
# Auth is Entra ID only: `az login` locally, managed identity on Azure. The
# identity needs the "Azure AI User" role on the Foundry project.
# FOUNDRY_PROJECT_ENDPOINT=
# FOUNDRY_MODEL_DEPLOYMENT=gpt-5-mini

# ── Azure OpenAI via Pydantic AI (runtime "chat"), same vars as invulhulp ──
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=gpt-5.3-chat
# AZURE_OPENAI_API_VERSION=2025-04-01-preview
# AZURE_OPENAI_REASONING_MODEL=false

# ── Local models via Ollama and Pydantic AI (runtime "ollama") ─────────────
# Native Ollama, backend run with uv:        http://localhost:11434
# Native Ollama, backend in docker compose:  http://host.docker.internal:11434
# (docker-compose.ollama.yml sets this itself when Ollama also runs in Docker)
# OLLAMA_BASE_URL=http://localhost:11434
# Needs a model with tool calling. Tested: mistral-small3.1:24b (good, slow),
# qwen2.5:3b (fast, weak), qwen3:8b.
# OLLAMA_MODEL=qwen3:8b
# OLLAMA_RUN_TIMEOUT_SEC=900
# Local tokens are free; give them a notional price to demo budgets:
# PRICE_OLLAMA_INPUT=0
# PRICE_OLLAMA_OUTPUT=0

# ── Work tools ─────────────────────────────────────────────────────────────
# web_search uses Brave Search when this is set, otherwise DuckDuckGo's HTML page.
# BRAVE_SEARCH_API_KEY=
# WORKTOOL_HTTP_TIMEOUT_SEC=20

# ── Tracing (OpenTelemetry, runtimes chat / ollama) ────────────────────────
# Off unless an OTLP endpoint is set. Standard OTEL_* variables apply
# (OTEL_EXPORTER_OTLP_HEADERS, OTEL_EXPORTER_OTLP_TRACES_ENDPOINT, …); export is OTLP over HTTP.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=regiekamer-backend
# Prompts, answers and tool arguments stay out of traces unless this is on (local debugging only):
# AGENT_TRACE_CONTENT=false

# ── Heartbeats ─────────────────────────────────────────────────────────────
# MAX_CONCURRENT_RUNS=3
# RUN_TIMEOUT_SEC=300
# AGENT_MAX_TOOL_ROUNDS=12
# MOCK_DELAY_SEC=1.5

# ── Pricing (euro cents per 1M tokens) ─────────────────────────────────────
# PRICE_DEFAULT_INPUT=125
# PRICE_DEFAULT_OUTPUT=1000
# PRICE_GPT_5_MINI_INPUT=25
# PRICE_GPT_5_MINI_OUTPUT=200

# ── Storage / web ──────────────────────────────────────────────────────────
# DB_PATH=data/regiekamer.db
# CORS_ORIGINS=http://localhost:5173
